{
  "name": "pet-world-agenda",
  "version": "1.0.0",
  "private": true,
  "description": "Pet shop appointment scheduling — webpack + json-server",
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:api\" \"npm:web\"",
    "web": "webpack serve --mode development",
    "api": "json-server server.json --port 3333",
    "build": "webpack --mode production"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-loader": "^10.1.1",
    "concurrently": "^10.0.5",
    "css-loader": "^7.1.4",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "json-server": "^1.0.0-beta.15",
    "mini-css-extract-plugin": "^2.10.2",
    "style-loader": "^4.0.0",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  },
  "browserslist": [
    "defaults",
    "not IE 11"
  ],
  "engines": {
    "node": ">=20"
  }
}